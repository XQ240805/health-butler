.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F7F5EF;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEF0EB;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #4E7C63;
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  color: #8A968D;
  margin-top: 4rpx;
}

.chat-list {
  flex: 1;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.row {
  display: flex;
  margin-bottom: 24rpx;
}

.row-user {
  justify-content: flex-end;
}

.row-butler {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-butler {
  background: #FFFFFF;
  color: #2E3A33;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(78, 124, 99, 0.05);
}

.bubble-user {
  background: #4E7C63;
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
}

.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 30rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C3CEC5;
  animation: blink 1.2s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.quick-wrap {
  margin: 8rpx 0 32rpx;
}

.quick-title {
  font-size: 24rpx;
  color: #8A968D;
  margin-bottom: 16rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  background: #EDF3EE;
  color: #4E7C63;
  border-radius: 100rpx;
  font-size: 25rpx;
}

.bottom-holder {
  height: 20rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEF0EB;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 26rpx;
  background: #F4F6F2;
  border-radius: 100rpx;
  font-size: 28rpx;
}

.send {
  margin-left: 20rpx;
  padding: 0 34rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 100rpx;
  background: #D6DED8;
  color: #FFFFFF;
  font-size: 28rpx;
}

.send-active {
  background: #4E7C63;
}
