<view class="container">
  <view class="hero">
    <view class="hero-season">{{season.label}}</view>
    <view class="hero-title">{{season.title}}</view>
    <view class="muted">{{dateText}} · 今日建议</view>
  </view>

  <view class="card" wx:for="{{season.items}}" wx:key="tag">
    <view class="row-head">
      <text class="tag">{{item.tag}}</text>
    </view>
    <view class="item-text">{{item.text}}</view>
  </view>

  <view class="card">
    <view class="card-title">今日三件小事</view>
    <view class="muted" style="margin-bottom: 12rpx;">已完成 {{doneCount}} / 3</view>
    <view
      wx:for="{{tasks}}"
      wx:key="index"
      class="task {{item.done ? 'task-done' : ''}}"
      data-index="{{index}}"
      bindtap="toggle"
    >
      <view class="check {{item.done ? 'check-on' : ''}}">
        <text wx:if="{{item.done}}">✓</text>
      </view>
      <view class="task-text">{{item.text}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">记录今天的身体状态</view>
    <view class="muted" style="margin-bottom: 24rpx;">睡眠、饮水、步数，记三天就能看出规律。</view>
    <view class="btn" bindtap="goRecords">去记录</view>
  </view>

  <view class="foot">以上为生活方式建议，不替代诊断。身体出现明显不适，请及时就医。</view>
</view>
